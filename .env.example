# PostgreSQL connection string
DATABASE_URL=postgresql://jobagent:jobagent@localhost:5432/jobagent

# OpenRouter API (OpenAI-compatible, FREE tier available)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# FREE model: meta-llama/llama-3.3-70b-instruct:free
# Paid but cheap: anthropic/claude-3.5-sonnet, openai/gpt-4o-mini
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_SITE_URL=https://github.com/yourproject
OPENROUTER_APP_NAME=job-discovery-agent

# WhatsApp Cloud API (Meta) - FREE 1,000 conversations/month
# Setup guide: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# 1. Create a Meta Developer account: https://developers.facebook.com
# 2. Create a new app with WhatsApp product
# 3. Get your access token and phone number ID from the dashboard
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=choose_any_random_secure_string_here
WHATSAPP_API_VERSION=v21.0

# Cron expressions (standard 5-field cron syntax)
# Jobs checked every 30 minutes, hackathons every hour
JOBS_CRON=*/30 * * * *
HACKATHONS_CRON=0 * * * *

# Server
PORT=3000
NODE_ENV=development

# Used by docker-compose to set the Postgres container password
POSTGRES_PASSWORD=jobagent

# Optional: HTTP client configuration
HTTP_TIMEOUT_MS=15000
HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/120.0.0.0 Safari/537.36 JobAgent/2.0
